# Direct Lambda Function URL. Do not put an API Gateway or CDN URL here.
VITE_NORTHSTAR_LAMBDA_URL=https://replace-me.lambda-url.us-east-1.on.aws

# Explicitly opt into an unauthenticated local-only shell when the local API
# is running with NORTHSTAR_AUTH_REQUIRED=false. Keep false for cloud use.
VITE_NORTHSTAR_DEV_MODE=false
