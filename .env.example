# Northstar runs its simulator and API locally without AWS credentials.
ENVIRONMENT_NAME=dev
AWS_REGION=us-east-1
NORTHSTAR_AUTH_REQUIRED=false
NORTHSTAR_CORS_ORIGINS=http://localhost:5173
NORTHSTAR_COGNITO_USER_POOL_ID=
NORTHSTAR_COGNITO_CLIENT_ID=
NORTHSTAR_COGNITO_ISSUER=
NORTHSTAR_ADMIN_GROUP=northstar-admin
NORTHSTAR_STATE_TABLE_NAME=

# Pin these for a cloud Harness smoke test; do not rely on service defaults.
HARNESS_MODEL_ID=us.amazon.nova-2-lite-v1:0
NORTHSTAR_HARNESS_ARN=
NORTHSTAR_GATEWAY_ARN=
NORTHSTAR_HARNESS_CONFIG=harness/config/northstar-harness.yaml
HARNESS_SMOKE_COMMAND=

# Optional hosted web smoke test command, for example a project-specific CLI.
WEB_SMOKE_COMMAND=

# Deployment controls.
IMAGE_PLATFORM=linux/arm64
SAM_COMMAND=sam
